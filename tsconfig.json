{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/client.ts", "src/forms.ts", "src/ui.ts", "src/views.ts", "src/finance.ts", "src/demo.ts", "test/finance.test.ts", "vite.config.ts", "cloudflare.config.ts"]
}
